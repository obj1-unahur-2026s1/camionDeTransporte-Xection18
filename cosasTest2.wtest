import camion.*
import cosas.*

describe "Test camión" {

  method initialize() {
    const cosasACargar = []
    camion.cargarCosas(cosasACargar)
  }

  test "El contenedor pesa 960 si le metemos embalaje, bumblebee y residuos de 30kg" {
    residuos.peso(30)
    embalaje.cosaEnvuelta(residuos)
    contenedor.agregarCosas([embalaje, residuos, bumblebee])
    assert.equals(30+30+800+100, contenedor.peso())
  }

}
