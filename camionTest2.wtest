import camion2.*
import cosas2.*

describe "Test camión" {

  method initialize() {
    bumblebee.cambiarForma(robot)
    arena.peso(150)
    bateria.estaConMisiles(true)
    paqueteDeLadrillos.cambiarCantidad(80)
    embalaje.cosaEnvuelta(paqueteDeLadrillos)
    camion.cargarCosas([bumblebee, arena, bateria, embalaje])
  }

  test "Test peso" {
    // bumblebee = 800
    // arena = 150
    // bateria = 300
    // embalaje = 160 
    assert.equals(1000 + 800 + 140 + 300+ 160, camion.peso())
  }

  test "Test pesos pares" {
    // bumblebee = 800
    // arena = 150
    // bateria = 300
    // embalaje = 160 
    assert.that(camion.todosLosPesosSonPares())
  }

  test "La cantidad total de bultos cargados en el camión es de " {
    // bumblebee ocupa 2
    // arena ocupa 1
    // bateria ocupa 2
    // embalaje ocupa 2
    assert.equals(7, camion.cantidadTotalDeBultos())
  }
  
}